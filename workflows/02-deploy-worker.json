{
  "id": "deploy-worker",
  "name": "02 - Worker de deploy (agente IA)",
  "nodes": [
    {
      "parameters": {
        "queue": "deploy-requests",
        "options": {
          "acknowledge": "executionFinishes",
          "parallelMessages": 1,
          "durable": true,
          "jsonParseBody": true,
          "onlyContent": true
        }
      },
      "id": "fila-deploy-requests",
      "name": "Fila deploy-requests",
      "type": "n8n-nodes-base.rabbitmqTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "credentials": {
        "rabbitmq": {
          "id": "rabbitmq-local",
          "name": "RabbitMQ local"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "dryRun",
              "type": "boolean",
              "value": true
            },
